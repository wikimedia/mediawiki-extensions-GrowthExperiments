{
	"extends": [
		"stylelint-config-wikimedia",
		"stylelint-config-wikimedia/mediawiki"
	],
	"rules": {
		"selector-max-id": null,
		"no-descending-specificity": null,
		"declaration-property-unit-disallowed-list": null,
		"declaration-no-important": null,
		"declaration-property-value-keyword-no-deprecated": null,
		"selector-class-pattern": null
	},
	"overrides": [
		{
			"files": [
				"documentation/frontend/**",
				"modules/ext.growthExperiments.Homepage.Impact/**",
				"modules/ext.growthExperiments.MentorDashboard/**",
				"modules/vue-components/**"
			],
			"rules": {
				"selector-class-pattern": "^(mw|oo-ui|cdx|client|skin|ext-growthExperiments)-"
			}
		}
	]
}
