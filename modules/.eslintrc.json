{
	"root": true,
	"extends": [
		"wikimedia/client",
		"wikimedia/jquery",
		"wikimedia/mediawiki"
	],
	"globals": {
		"ge": "writable",
		"ve": "readonly"
	},
	"env": {
		"commonjs": true
	},
	"rules": {
		"max-len": "off"
	},
	"settings": {
		"jsdoc": {
			"preferredTypes": {
				"EndOfQueueWidget": "EndOfQueueWidget",
				"ErrorCardWidget": "ErrorCardWidget",
				"Help": "Help",
				"mw.libs.ge.GrowthTasksApi": "mw.libs.ge.GrowthTasksApi",
				"NoResultsWidget": "NoResultsWidget",
				"PostEditPanel": "PostEditPanel",
				"QuestionPosterDialog": "QuestionPosterDialog",
				"SuggestedEditCardWidget": "SuggestedEditCardWidget",
				"SuggestedEditSession": "SuggestedEditSession",
				"SuggestionWidget": "SuggestionWidget"
			}
		}
	},
	"overrides": [
		{
			"files": [
				"**/*.test.js"
			],
			"extends": [
				"wikimedia/server"
			],
			"env": {
				"jest": true
			}
		},
		{
			"files": [
				"**/*.vue"
			],
			"rules": {
				"vue/component-name-in-template-casing": [
					"error",
					"kebab-case"
				],
				"vue/max-len": [
					"error",
					{
						"code": 120,
						"template": 120,
						"comments": 120
					}
				],
				"vue/multi-word-component-names": [
					"error",
					{
						"ignores": [
							"Impact"
						]
					}
				]
			}
		},
		{
			"files": [
				"**/*.js",
				"**/*.vue"
			],
			"rules": {
				"comma-dangle": [
					"error",
					"always-multiline"
				]
			}
		}
	]
}
